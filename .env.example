VITE_API_BASE_URL=http://localhost:5000/api

# ── TeamSpec API server (copy to .env, never commit .env) ─────────────────────
PORT=5000
# Public URL of the frontend (Vite dev server proxies /api → :5000)
APP_URL=http://localhost:3000
# Random string, keeps login sessions valid across server restarts
SESSION_SECRET=change-me-to-a-long-random-string

# ── Knowledge base source ────────────────────────────────────────────────────
# github = read the team repo through the GitHub API, local = read KB_PATH on disk
KB_SOURCE=github
GITHUB_OWNER=minhduc118
GITHUB_REPO=ai-team-kit
GITHUB_BRANCH=main
# Folder of the KB inside the repo (empty when the KB is the repo root)
GITHUB_KB_DIR=team-ai-knowledge
# Optional: token used for reads when the user logged in with password (private repo / rate limit)
GITHUB_TOKEN=

# Used when KB_SOURCE=local
KB_PATH=../ai-team-kit/team-ai-knowledge

# ── GitHub OAuth App (github.com/settings/developers → New OAuth App) ─────────
# Homepage URL:               http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# "read:user" is enough for a public repo; "repo" is needed to read a private one
GITHUB_OAUTH_SCOPE=read:user repo
# Extra GitHub usernames allowed to log in without being repo collaborators (comma-separated)
GITHUB_ALLOWED_USERS=

# ── Production (npm start) ────────────────────────────────────────────────────
# NODE_ENV=production serves dist/ from Express; "/" redirects to /teamspec unless TEAMSPEC_ONLY=false
# NODE_ENV=production
# TEAMSPEC_ONLY=true
# Team passwords are hard-coded (teamMembers.ts) → login by password is off in production unless set to true
# PASSWORD_LOGIN=false
